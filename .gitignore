node_modules/
npm-debug.log*

# Standalone source-build root for the client UI forks (generated tree + toolchain).
.srcbuild/

# Scratch output of scripts/port-fork-baseline.mjs.
.port-probe/

# Browser and isolated DSH runtime profiles (large, local, and may contain credentials).
sandbox/.edge-final/
sandbox/edge-fork-profile/
sandbox/dsh-home/
sandbox/.desktop-*/home/
sandbox/.desktop-*/electron-*/
releases/*/preinstall-backup/

# claw-kit transient state; keep project plans, Truth, and reports.
.claw/runtime/
.claw/logs/
.claw/memory.sqlite*
.claw/tasks/

# Generated composition dumps and screenshots are machine-specific evidence.
sandbox/*-composed.yml
sandbox/*.png

# Public-release scratch and private deployment evidence; stage only safe manifests explicitly.
.release-public-lock-*/
.public-release-*/
sandbox/.desktop-*/
releases/0.3.0/

# --- local-only evidence and vendored inputs (2026-10-18 cleanup) -----------------
# Upstream source tarballs and the per-fork official baselines are re-downloadable with
# npm pack / the codeload URL pinned in provenance/source.lock.json; they are tens of MB.
/third_party/

# Release staging from older lines: local inspection evidence, not shipped code. The one
# exception is the audited 0.2.1 fork library, whose candidates.json is referenced by docs.
/releases/*
!/releases/0.2.1-rc.2-forks/

# Local sandbox evidence (profiles, screenshots, compose dumps). sandbox/acceptance.md is
# tracked and stays tracked: git keeps tracked files even under an ignored directory.
/sandbox/

# Scratch staging roots created by release scripts.
/.public-release-*/
/.release-public-lock-*/
/payload/
# Archived task state: workflow history, not source.
/.claw/archive/
