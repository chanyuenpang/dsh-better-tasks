+/* Original task-card values, not the main composer's layout. No measured sizing. */
+.host { min-width: 0; width: 100%; }
+.surface { position: relative; box-sizing: border-box; display: flex; flex-direction: column; min-width: 0; width: 100%; border: 1px solid var(--dsw-alias-border-l1); border-radius: 18px; background: var(--dsw-specific-input-major); box-shadow: var(--dsw-elevation-soft); color: var(--dsw-alias-label-primary); cursor: text; }
+.surface:focus-within { border-color: var(--dsw-alias-brand-primary); }
+.scroll { overflow-y: auto; max-height: 120px; min-width: 0; }
+.grow { position: relative; min-height: 32px; }
+.input { box-sizing: border-box; min-width: 0; min-height: 32px; padding: 7px 11px 5px; outline: none; border: 0; border-radius: 18px 18px 0 0; background: transparent; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; font-size: 12px; line-height: 18px; }
+.input p { margin: 0; }
+.input p:last-child::after { content: var(--dsh-composer-hint); color: var(--dsw-alias-label-caption); }
+.input[data-composer-composing] p:last-child::after { content: none; }
+.inputDisabled { opacity: .6; }
+.placeholder { position: absolute; inset: 7px 11px 5px; pointer-events: none; color: var(--dsw-alias-label-secondary); font-size: 12px; line-height: 18px; }
+.input:focus + .placeholder, .input[data-composer-composing] + .placeholder { display: none; }
+.actions { box-sizing: border-box; display: flex; justify-content: space-between; align-items: center; min-height: 36px; padding: 1px 6px 6px; }
+.add { display: grid; place-items: center; flex: none; width: 27px; height: 27px; padding: 0; border: 0; border-radius: 7px; background: transparent; color: var(--dsw-alias-label-secondary); cursor: pointer; }
+.add:hover, .add[aria-expanded="true"] { background: var(--dsw-alias-interactive-bg-hover); color: var(--dsw-alias-label-primary); }
+.add:disabled, .send:disabled { opacity: .4; cursor: default; }
+.add:focus-visible, .search:focus-visible { outline: 2px solid var(--dsw-alias-brand-primary); outline-offset: 1px; }
+.send { corner-shape: round; flex: none; display: grid; place-items: center; box-sizing: border-box; width: 28px; height: 28px; padding: 0; border: 0; border-radius: 999px; background: var(--dsw-alias-button-info-fill); color: #fff; cursor: pointer; transition: background-color .1s; }
+.send:hover:not(:disabled) { background: var(--dsw-alias-button-info-hover); }
+.send:focus-visible { outline: 2px solid var(--dsw-alias-brand-primary); outline-offset: 2px; }
+.picker { margin: 0 7px 4px; padding: 7px; border: 1px solid var(--dsw-alias-border-l1); border-radius: 10px; background: var(--dsw-alias-bg-layer-1); box-shadow: var(--dsw-elevation-soft); cursor: default; }
+.picker[hidden] { display: none; }
+.search { box-sizing: border-box; width: 100%; height: 29px; padding: 4px 7px; border: 1px solid var(--dsw-alias-border-l1); border-radius: 6px; background: var(--dsw-specific-input-major); color: var(--dsw-alias-label-primary); font: inherit; font-size: 12px; }
+/* Native inline view supplies an inline cap; this card keeps its original 180px list. */
+.picker [data-trigger-menu] { max-height: 180px !important; margin-top: 5px; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
+.picker [role="option"] { min-width: 0; padding: 5px 7px; border-radius: 6px; font-size: 12px; }
+.picker [role="option"][id*="-skill-"] { flex-direction: column; align-items: flex-start; gap: 1px; }
+.status { padding: 6px; color: var(--dsw-alias-label-secondary); font-size: 11px; }
+.popup { margin: 0 7px; cursor: default; }
+.notice { margin-top: 4px; padding: 4px 8px; font-size: 11px; overflow-wrap: anywhere; color: var(--dsw-alias-label-secondary); cursor: default; }
