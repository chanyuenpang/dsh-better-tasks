--- a/packages/client/ui-conversation/src/client/input/session-reference-drop-zone.ts
+++ b/packages/client/ui-conversation/src/client/input/session-reference-drop-zone.ts
@@ -0,0 +1,47 @@
+/** Area-local routing only; the mounted main composer still owns every edit. */
+import { createContext } from 'react'
+import type { DragEvent } from 'react'
+import { isSessionReferenceDrag } from './session-reference-drag.mjs'
+
+type DropEvent = DragEvent<HTMLElement>
+export interface SessionReferenceDropOwner {
+  readonly sessionId: string
+  over(event: DropEvent): void
+  drop(event: DropEvent): void
+  leave(event: DropEvent): void
+  cancel(): void
+}
+
+/** One instance per resident ConversationContent, never a global current editor. */
+export class SessionReferenceDropZone {
+  private owner: SessionReferenceDropOwner | undefined
+  constructor(private readonly feedback: (active: boolean) => void = () => {}) {}
+  register(owner: SessionReferenceDropOwner): () => void {
+    this.owner?.cancel()
+    this.owner = owner
+    return () => {
+      owner.cancel()
+      if (this.owner === owner) { this.owner = undefined; this.feedback(false) }
+    }
+  }
+  route(kind: 'over' | 'drop' | 'leave', event: DropEvent, sessionId: string | undefined, main: boolean): void {
+    if (!isSessionReferenceDrag(event.dataTransfer)) return
+    // A nested/embedded conversation keeps its own refusal/owner, not the outer main target.
+    const target = event.target as HTMLElement
+    if (target.closest?.('[data-conversation-content]') !== event.currentTarget) { this.feedback(false); return }
+    const owner = this.owner
+    if (main && sessionId !== undefined && owner?.sessionId === sessionId) {
+      if (kind === 'drop' || kind === 'leave' && (!(event.relatedTarget instanceof Node) || !event.currentTarget.contains(event.relatedTarget))) this.feedback(false)
+      owner[kind](event)
+      if (kind === 'over') this.feedback(event.dataTransfer.dropEffect === 'copy')
+      return
+    }
+    // Never let a private payload degrade into a browser text/plain ID insertion.
+    this.feedback(false)
+    event.preventDefault()
+    event.stopPropagation()
+    event.dataTransfer.dropEffect = 'none'
+  }
+}
+
+export const SessionReferenceDropContext = createContext<SessionReferenceDropZone | undefined>(undefined)
