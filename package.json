{
  "name": "@veewo/dsh-better-tasks",
  "version": "0.3.1",
  "type": "module",
  "description": "DSH Desktop sidebar replacement with native pinned-task cards and independent task input surfaces.",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanyuenpang/dsh-better-tasks.git"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./fork-layer": "./src/fork-layer.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "src/**/*.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "docs/release.md",
    "docs/rollback.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-user-questions"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:fork": "node scripts/build-forks-from-source.mjs --build",
    "test:prepare": "node scripts/build-forks-from-source.mjs --test-source",
    "check": "node --check src/index.js && node --check src/client.js && node --check lib/client.js",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "desktop",
    "sidebar",
    "tasks"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-user-questions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5"
  },
  "bundledDependencies": [
    "@deepseek-ai/dsh-client-ui-layout",
    "@deepseek-ai/dsh-client-ui-workspace",
    "@deepseek-ai/dsh-client-ui-user-questions",
    "@deepseek-ai/dsh-client-ui-input-trigger",
    "@deepseek-ai/dsh-client-ui-commands",
    "@deepseek-ai/dsh-client-ui-conversation"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2"
  },
  "devDependencies": {
    "diff": "^9.0.0"
  }
}
