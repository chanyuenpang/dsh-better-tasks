+/** One composer-owned asynchronous insertion; transport never grants authority. */
+import type { ISessions } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { ReferenceInsert, TokenSpan } from '../contract/draft-editor.ts'
+
+export interface SessionDropShell {
+  readonly snapshot: { readonly draftRev: number }
+  insertReference(value: ReferenceInsert, span: TokenSpan, historyBoundary?: boolean): boolean
+}
+export type InsertSessionReference = (sourceId: string, span: TokenSpan, signal: AbortSignal, current: () => boolean) => Promise<boolean>
+
+/** Native lookup is deliberately late-bound: its absence must not block startup. */
+export function createSessionReferenceInsertion(options: {
+  sessions: ISessions
+  targetId: SessionId
+  shell: SessionDropShell
+  resolve: () => { candidates(target: SessionId, query: string, signal: AbortSignal): Promise<{ ok: boolean; value?: readonly { sessionId: string; mention: string; label: string; displayTitle?: string }[] }> } | undefined
+}): InsertSessionReference {
+  return async (sourceId, span, signal, current) => {
+    if (sourceId === options.targetId || !current()) return false
+    const binding = options.sessions.binding(options.targetId)
+    const resolver = options.resolve()
+    if (binding === undefined || resolver === undefined) return false
+    return options.sessions.using(options.targetId, { source: 'controllerOperation', signal }, async reference => {
+      const stillCurrent = (): boolean => !signal.aborted && current()
+        && reference.binding === binding && options.sessions.binding(options.targetId) === binding
+        && options.shell.snapshot.draftRev === span.draftRev
+      if (!stillCurrent() || binding.session.getSnapshot().openState !== 'open') return false
+      const result = await resolver.candidates(options.targetId, sourceId, signal)
+      if (!stillCurrent() || !result.ok) return false
+      const candidate = result.value?.find(value => value.sessionId === sourceId)
+      if (candidate === undefined || typeof candidate.mention !== 'string' || !candidate.mention.startsWith('@[')) return false
+      return options.shell.insertReference({
+        source: 'reference', ref: candidate.mention,
+        label: candidate.displayTitle ?? candidate.label,
+        appearance: 'session', clipboardText: candidate.mention,
+      }, span, true)
+    })
+  }
+}
+
+/** Instance generation plus request identity: switching away and back is stale. */
+export class SessionReferenceDropTransaction {
+  private generation = 0
+  private pending: AbortController | undefined
+  cancel(): void {
+    this.generation++
+    this.pending?.abort()
+    this.pending = undefined
+  }
+  async insert(insert: InsertSessionReference, sourceId: string, span: TokenSpan, current: () => boolean): Promise<'inserted' | 'stale' | 'rejected'> {
+    this.cancel()
+    const generation = this.generation, controller = new AbortController()
+    this.pending = controller
+    const active = (): boolean => !controller.signal.aborted && this.generation === generation && current()
+    try {
+      if (!active()) return 'stale'
+      const applied = await insert(sourceId, span, controller.signal, active)
+      return !active() ? 'stale' : applied ? 'inserted' : 'rejected'
+    } catch {
+      return active() ? 'rejected' : 'stale'
+    } finally {
+      if (this.pending === controller) this.pending = undefined
+    }
+  }
+}
